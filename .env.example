# Application
APP_ENV=development
APP_NAME=Kisan Saathi
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=kisan_saathi
MONGODB_VECTOR_INDEX=scheme_chunks
MONGODB_VECTOR_FIELD=embedding

# Google Cloud
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GCS_BUCKET=<gcs-bucket>

# Vertex AI Gemini
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Google Speech
SPEECH_LANGUAGE_CODE=hi-IN
SPEECH_STT_MODEL=latest_long
SPEECH_TTS_VOICE=hi-IN-Wavenet-A
SPEECH_TTS_AUDIO_ENCODING=MP3

# Google Earth Engine
GEE_PROJECT=<gcp-project-id>
GEE_SERVICE_ACCOUNT=<service-account>@<gcp-project-id>.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/absolute/path/to/gee-service-account.json
GEE_COLLECTION_LANDSAT=LANDSAT/LC09/C02/T1_L2
GEE_COLLECTION_SENTINEL2=COPERNICUS/S2_SR_HARMONIZED
GEE_COLLECTION_WEATHER=ECMWF/ERA5_LAND/DAILY_AGGR

# Optional ISRO sources
BHOONIDHI_STAC_URL=https://bhoonidhi.nrsc.gov.in/bhoonidhi/stac
BHOONIDHI_API_KEY=
MOSDAC_API_URL=https://www.mosdac.gov.in/
MOSDAC_API_KEY=

# Weather and mandi data
OPENWEATHER_API_KEY=
MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MANDI_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Places
GOOGLE_MAPS_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=hi

# Frontend Firebase Authentication (fill from the Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
